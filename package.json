{
  "name": "thaana",
  "version": "0.0.0",
  "private": true,
  "description": "Dhivehi-first shadcn registry for React and TypeScript projects.",
  "homepage": "https://thaana.yazak.me",
  "repository": {
    "type": "git",
    "url": "https://github.com/oreofreakshake/thaana.git"
  },
  "bugs": {
    "url": "https://github.com/oreofreakshake/thaana/issues"
  },
  "keywords": [
    "dhivehi",
    "thaana",
    "rtl",
    "shadcn",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm registry:build && vite build",
    "build:docs": "vite build",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "registry:build": "shadcn build",
    "registry:validate": "shadcn registry validate ./registry.json",
    "test": "node --test tests/text-direction.test.mjs && vitest run tests/components.test.tsx --environment jsdom",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm check && pnpm typecheck && pnpm test && pnpm registry:validate && pnpm build"
  },
  "dependencies": {
    "@daypicker/hijri": "^10.0.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.33.0",
    "maplibre-gl": "^6.6.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.17.1"
}
